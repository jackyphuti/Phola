<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Phola</string>
	<key>CFBundleExecutable</key>
	<string>Phola</string>
	<key>CFBundleIdentifier</key>
	<string>com.phola.phola</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Phola</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>fetch</string>
		<string>processing</string>
		<string>remote-notification</string>
	</array>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Phola requires your live location to display nearby safe havens, provide emergency navigation, and share your GPS with emergency services and contacts.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Phola requires continuous background location access to protect your safety, monitor danger zones, and share live tracking with your guardian circle even when the app is closed.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Phola monitors your travel and location in the background to detect emergency deviations, trigger distress alerts, and broadcast live coordinates to your emergency contacts even when the app is closed.</string>
	<key>NSCameraUsageDescription</key>
	<string>Phola uses the camera to capture evidence and attach photos to incident reports.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Phola accesses your photos so you can attach incident evidence or profile photos.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Phola uses the microphone to record emergency audio notes and voice evidence.</string>
</dict>
