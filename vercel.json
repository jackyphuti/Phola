{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "functions": {
    "api/index.py": {
      "includeFiles": "api/**",
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/py-api/:path*",
      "destination": "/api/index.py?__path=/:path*"
    },
    {
      "source": "/api/py/:path*",
      "destination": "/api/index.py?__path=/:path*"
    }
  ]
}
